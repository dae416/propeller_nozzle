GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#22)) GLOBAL_UNIT_ASSIGNED_CONTEXT(
(#19,#20,#21)) REPRESENTATION_CONTEXT('Context #1',
  '3D Context with UNIT and UNCERTAINTY') );
#19 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#20 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#21 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#22 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#19,
  'distance_accuracy_value','confusion accuracy');
#23 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
